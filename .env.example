# =============================================
# KINEFY — Variables de entorno necesarias
# Copia este archivo como .env y rellena los valores reales
# NUNCA subas el archivo .env al repositorio
# =============================================

# --- Base de Datos ---
# Local:   mongodb://localhost:27017/kinefy
# Docker:  mongodb://mongodb:27017/kinefy
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/kinefy
MONGO_URI=mongodb://localhost:27017/kinefy

# --- Autenticación JWT ---
# Clave secreta para firmar los tokens. Usa una cadena larga y aleatoria.
# Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# --- Servidor ---
PORT=5000

# Entorno: development | production | test
NODE_ENV=development

# --- CORS ---
# URL del frontend autorizada. En producción pon la URL de Vercel (sin barra final).
# Varias URLs separadas por coma: https://kinefy.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Email (Nodemailer) ---
# Configuración SMTP para notificaciones por correo.
# Ejemplo con Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
